generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  customer
  seller
  admin
}

enum OrderStatus {
  // Active MVP Marketplace Statuses
  SUBMITTED
  ACCEPTED
  PREPARING
  DELIVERED
  COMPLETED
  CANCELLED

  // Legacy/Future Payment Statuses (Preserved)
  PENDING
  PAID
  SHIPPED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(customer)
  
  // Mandatory for MVP direct buyer-seller contact
  phoneNumber    String   @default("")
  whatsappNumber String?

  county         String?
  town           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  products       Product[]        @relation("SellerProducts")
  orders         Order[]          @relation("BuyerOrders")
  sellerOrders   Order[]          @relation("SellerOrders")
  payments       Payment[]
  clickAnalytics ClickAnalytics[]
  notifications  Notification[]   // 👈 Fixed missing inverse relation
}

model Product {
  id          String        @id @default(uuid())
  name        String
  price       Float
  unit        String
  stock       Int
  category    String        @default("general")
  description String        @default("")
  status      ProductStatus @default(PENDING)
  
  // Link product to a seller (Defaults to null for backfilled legacy products)
  sellerId    String?
  seller      User?         @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems  OrderItem[]
}

model Order {
  id                     String      @id @default(uuid())
  orderNumber            String      @unique @default(cuid())

  // Buyer relation
  userId                 String
  user                   User        @relation("BuyerOrders", fields: [userId], references: [id], onDelete: Cascade)

  // Seller relation (Optional for guest checkouts / single-seller routing)
  sellerId               String?
  seller                 User?       @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: SetNull)

  subtotal               Float
  status                 OrderStatus @default(SUBMITTED)
  
  // Delivery location
  county                 String
  town                   String
  deliveryAddress        String?

  // MVP Direct Contact & Payment Preference
  preferredPaymentMethod String?     // e.g. "M-Pesa", "Cash on Delivery"
  cancellationReason     String?

  items                  OrderItem[]
  payment                Payment?

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name      String
  unitPrice Float
  unit      String
  quantity  Int
  lineTotal Float
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount           Float
  method           String        @default("FLUTTERWAVE")
  phone            String?

  status           PaymentStatus @default(INITIATED)
  gatewayReference String?
  receiptNumber    String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// Analytics tracking model for CEO business brief
model ClickAnalytics {
  id        String   @id @default(uuid())
  userId    String?
  orderId   String?
  eventType String   // "WHATSAPP_CLICK", "CALL_CLICK", "PREFERRED_PAYMENT_CLICK"
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // Recipient (Buyer, Seller, or Admin)
  orderId   String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}